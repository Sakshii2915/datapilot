# ==========================================
# DataPilot Environment Configuration
# ==========================================

# OpenAI API Configuration
# Leave blank or set to 'mock' to use built-in intelligent mock LLM mode for testing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL default, SQLite fallback supported)
# Primary read-write connection (used by API for history and admin/seed scripts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datapilot
# Read-only connection for safe user query execution
READONLY_DATABASE_URL=postgresql://datapilot_ro:datapilot_ro_pass@localhost:5432/datapilot

# Alternatively for standalone local zero-dependency development with SQLite:
# DATABASE_URL=sqlite:///./datapilot.db
# READONLY_DATABASE_URL=sqlite:///./datapilot.db

# Query Safety & Limits
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=10
MAX_SQL_CORRECTION_ATTEMPTS=3

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_V1_STR=/api
